# Nexis AI Environment example

Add PRESIGNED_URL_EXPIRY_SECONDS to control presigned S3 link lifetime (in seconds).

PRESIGNED_URL_EXPIRY_SECONDS=3600

# HTTP retry/backoff settings for external API calls
RETRY_ATTEMPTS=3
AXIOS_TIMEOUT_MS=60000

# API key protecting the reply presigned-URL endpoint
REPLY_ENDPOINT_API_KEY=replace-with-a-secure-value

# Rate limiting for the reply endpoint (per IP)
REPLY_RATE_WINDOW_MS=60000
REPLY_RATE_MAX=30

# Env example for the alert forwarder

# Secret used to authenticate incoming alert POSTS from Nexis backend
ALERT_FORWARDER_SECRET=replace-with-a-secure-token

# Optional forwarding destinations
FORWARD_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T/...
PAGERDUTY_ROUTING_KEY=replace-with-pagerduty-routing-key

# Deduplication TTL (seconds)
FORWARDER_DEDUPE_TTL_SECONDS=300

# Retry/backoff settings for forwarding
FORWARDER_RETRY_ATTEMPTS=3
FORWARDER_RETRY_BASE_MS=500

# Port to listen on
FORWARDER_PORT=8080
